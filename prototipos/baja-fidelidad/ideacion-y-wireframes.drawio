  <diagram name="I1. Ideación — Personas y mapa de empatía" id="vn4CcFHVXlRDN03dDeh9">
    <mxGraphModel grid="0" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="1560" pageHeight="1000" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="n4322_1" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=19;fontStyle=1;fontColor=#333333;" value="Ideación inicial — Arquetipos de usuario (personas) y mapa de empatía" vertex="1">
          <mxGeometry height="40" width="1500" x="20" y="10" as="geometry" />
        </mxCell>
        <mxCell id="n4322_2" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#888888;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontColor=#333333;" value="" vertex="1">
          <mxGeometry height="400" width="720" x="50" y="70" as="geometry" />
        </mxCell>
        <mxCell id="n4322_3" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e0e0e0;strokeColor=#888888;fontSize=11;fontStyle=1;fontColor=#222222;" value="Ana, 41 años — Propietaria, depto 1204" vertex="1">
          <mxGeometry height="30" width="720" x="50" y="70" as="geometry" />
        </mxCell>
        <mxCell id="n4322_4" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#333333;" value="Contexto: trabaja fuera todo el día, dos hijos. Usa el teléfono para casi todo." vertex="1">
          <mxGeometry height="40" width="690" x="62" y="108" as="geometry" />
        </mxCell>
        <mxCell id="n4322_5" parent="1" style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#333333;" value="Necesita:&amp;nbsp;&lt;div&gt;• Saber cuánto debe sin llamar a la administración.&amp;nbsp;&lt;/div&gt;&lt;div&gt;• Pagar desde el teléfono, a cualquier hora.&amp;nbsp;&lt;/div&gt;&lt;div&gt;• Entender de dónde sale el monto de su cuota.&lt;/div&gt;" vertex="1">
          <mxGeometry height="110" width="340" x="62" y="156" as="geometry" />
        </mxCell>
        <mxCell id="n4322_6" parent="1" style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#333333;" value="Le frustra:&amp;nbsp;&lt;div&gt;• Enterarse de que debe cuando ya hay interés.&amp;nbsp;&lt;div&gt;• Que el monto cambie sin explicación.&amp;nbsp;&lt;/div&gt;&lt;div&gt;• Tener que ir a la oficina en horario laboral.&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="110" width="340" x="416" y="156" as="geometry" />
        </mxCell>
        <mxCell id="n4322_7" parent="1" style="line;strokeColor=#bbbbbb;" value="" vertex="1">
          <mxGeometry height="1" width="694" x="62" y="276" as="geometry" />
        </mxCell>
        <mxCell id="n4322_8" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#333333;" value="Cita representativa" vertex="1">
          <mxGeometry height="16" width="200" x="62" y="284" as="geometry" />
        </mxCell>
        <mxCell id="n4322_9" parent="1" style="text;html=1;align=left;fontSize=10;fontStyle=2;fontColor=#555555;" value="“Me entero de que debo cuando ya me cobraron interés.”" vertex="1">
          <mxGeometry height="26" width="690" x="62" y="302" as="geometry" />
        </mxCell>
        <mxCell id="n4322_10" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#333333;" value="Pantallas que lo resuelven: M1, M2, M3, M4, M5" vertex="1">
          <mxGeometry height="20" width="690" x="62" y="336" as="geometry" />
        </mxCell>
        <mxCell id="n4322_11" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#555555;" value="Técnica aplicada: entrevista breve y mapa de empatía (qué piensa, siente, hace y le duele)." vertex="1">
          <mxGeometry height="20" width="690" x="62" y="362" as="geometry" />
        </mxCell>
        <mxCell id="n4322_12" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#888888;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontColor=#333333;" value="" vertex="1">
          <mxGeometry height="400" width="720" x="810" y="70" as="geometry" />
        </mxCell>
        <mxCell id="n4322_13" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e0e0e0;strokeColor=#888888;fontSize=11;fontStyle=1;fontColor=#222222;" value="Luis, 29 años — Arrendatario, depto 0803" vertex="1">
          <mxGeometry height="30" width="720" x="810" y="70" as="geometry" />
        </mxCell>
        <mxCell id="n4322_14" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#333333;" value="Contexto: arrienda hace 8 meses, primera vez que vive en edificio con gastos comunes." vertex="1">
          <mxGeometry height="40" width="690" x="822" y="108" as="geometry" />
        </mxCell>
        <mxCell id="n4322_15" parent="1" style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#333333;" value="Necesita:&amp;nbsp;&lt;div&gt;• Distinguir qué le corresponde pagar a él y qué al dueño.&amp;nbsp;&lt;/div&gt;&lt;div&gt;• Un recordatorio antes del vencimiento, no después.&amp;nbsp;&lt;/div&gt;&lt;div&gt;• Comprobante digital de cada pago.&lt;/div&gt;" vertex="1">
          <mxGeometry height="110" width="340" x="822" y="156" as="geometry" />
        </mxCell>
        <mxCell id="n4322_16" parent="1" style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#333333;" value="Le frustra:&amp;nbsp;&lt;div&gt;• No saber si un gasto extraordinario le aplica.&amp;nbsp;&lt;/div&gt;&lt;div&gt;• Perder el comprobante en papel.&amp;nbsp;&lt;/div&gt;&lt;div&gt;• Los avisos que llegan cuando ya está atrasado.&lt;/div&gt;" vertex="1">
          <mxGeometry height="110" width="340" x="1176" y="156" as="geometry" />
        </mxCell>
        <mxCell id="n4322_17" parent="1" style="line;strokeColor=#bbbbbb;" value="" vertex="1">
          <mxGeometry height="1" width="694" x="822" y="276" as="geometry" />
        </mxCell>
        <mxCell id="n4322_18" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#333333;" value="Cita representativa" vertex="1">
          <mxGeometry height="16" width="200" x="822" y="284" as="geometry" />
        </mxCell>
        <mxCell id="n4322_19" parent="1" style="text;html=1;align=left;fontSize=10;fontStyle=2;fontColor=#555555;" value="“No sé si el arreglo del ascensor me toca a mí o al dueño.”" vertex="1">
          <mxGeometry height="26" width="690" x="822" y="302" as="geometry" />
        </mxCell>
        <mxCell id="n4322_20" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#333333;" value="Pantallas que lo resuelven: M2, M3, M5" vertex="1">
          <mxGeometry height="20" width="690" x="822" y="336" as="geometry" />
        </mxCell>
        <mxCell id="n4322_21" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#555555;" value="Técnica aplicada: entrevista breve y mapa de empatía (qué piensa, siente, hace y le duele)." vertex="1">
          <mxGeometry height="20" width="690" x="822" y="362" as="geometry" />
        </mxCell>
        <mxCell id="n4322_22" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#888888;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontColor=#333333;" value="" vertex="1">
          <mxGeometry height="400" width="720" x="50" y="500" as="geometry" />
        </mxCell>
        <mxCell id="n4322_23" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e0e0e0;strokeColor=#888888;fontSize=11;fontStyle=1;fontColor=#222222;" value="Patricia, 55 años — Administradora del edificio" vertex="1">
          <mxGeometry height="30" width="720" x="50" y="500" as="geometry" />
        </mxCell>
        <mxCell id="n4322_24" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#333333;" value="Contexto: administra 160 unidades con planillas de cálculo y avisos impresos." vertex="1">
          <mxGeometry height="40" width="690" x="62" y="538" as="geometry" />
        </mxCell>
        <mxCell id="n4322_25" parent="1" style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#333333;" value="Necesita:&amp;nbsp;&lt;div&gt;• Calcular el prorrateo sin errores ni horas de planilla.&amp;nbsp;&lt;div&gt;• Ver de un vistazo quién está moroso y hace cuánto.&amp;nbsp;&lt;/div&gt;&lt;div&gt;• Enviar avisos masivos y dejar registro de ello.&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="110" width="340" x="62" y="586" as="geometry" />
        </mxCell>
        <mxCell id="n4322_26" parent="1" style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#333333;" value="Le frustra:&amp;nbsp;&lt;div&gt;• Recalcular todo cuando llega una factura atrasada.&amp;nbsp;&lt;/div&gt;&lt;div&gt;• Los reclamos por montos que no puede explicar.&amp;nbsp;&lt;/div&gt;&lt;div&gt;• No tener respaldo de a quién avisó y cuándo.&lt;/div&gt;" vertex="1">
          <mxGeometry height="110" width="340" x="416" y="586" as="geometry" />
        </mxCell>
        <mxCell id="n4322_27" parent="1" style="line;strokeColor=#bbbbbb;" value="" vertex="1">
          <mxGeometry height="1" width="694" x="62" y="706" as="geometry" />
        </mxCell>
        <mxCell id="n4322_28" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#333333;" value="Cita representativa" vertex="1">
          <mxGeometry height="16" width="200" x="62" y="714" as="geometry" />
        </mxCell>
        <mxCell id="n4322_29" parent="1" style="text;html=1;align=left;fontSize=10;fontStyle=2;fontColor=#555555;" value="“Paso dos días al mes cuadrando la planilla del prorrateo.”" vertex="1">
          <mxGeometry height="26" width="690" x="62" y="732" as="geometry" />
        </mxCell>
        <mxCell id="n4322_30" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#333333;" value="Pantallas que lo resuelven: D1, D2, D3, D4" vertex="1">
          <mxGeometry height="20" width="690" x="62" y="766" as="geometry" />
        </mxCell>
        <mxCell id="n4322_31" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#555555;" value="Técnica aplicada: entrevista breve y mapa de empatía (qué piensa, siente, hace y le duele)." vertex="1">
          <mxGeometry height="20" width="690" x="62" y="792" as="geometry" />
        </mxCell>
        <mxCell id="n4322_32" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#888888;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontColor=#333333;" value="" vertex="1">
          <mxGeometry height="400" width="720" x="810" y="500" as="geometry" />
        </mxCell>
        <mxCell id="n4322_33" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e0e0e0;strokeColor=#888888;fontSize=11;fontStyle=1;fontColor=#222222;" value="Marco, 38 años — Conserje" vertex="1">
          <mxGeometry height="30" width="720" x="810" y="500" as="geometry" />
        </mxCell>
        <mxCell id="n4322_34" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#333333;" value="Contexto: turno de 12 horas, atiende consultas y recibe pagos en efectivo o transferencia." vertex="1">
          <mxGeometry height="40" width="690" x="822" y="538" as="geometry" />
        </mxCell>
        <mxCell id="n4322_35" parent="1" style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#333333;" value="Necesita: •&lt;div&gt;&amp;nbsp;Consultar rápido si un residente está al día.&amp;nbsp;&lt;/div&gt;&lt;div&gt;• Registrar un pago presencial sin errores.&amp;nbsp;&lt;/div&gt;&lt;div&gt;• Acceso acotado, sin responsabilidad sobre montos.&lt;/div&gt;" vertex="1">
          <mxGeometry height="110" width="340" x="822" y="586" as="geometry" />
        </mxCell>
        <mxCell id="n4322_36" parent="1" style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#333333;" value="Le frustra:&amp;nbsp;&lt;div&gt;• Que le pregunten cosas que no puede responder.&amp;nbsp;&lt;/div&gt;&lt;div&gt;• Anotar pagos en cuaderno y que se pierdan.&lt;/div&gt;" vertex="1">
          <mxGeometry height="110" width="340" x="1176" y="586" as="geometry" />
        </mxCell>
        <mxCell id="n4322_37" parent="1" style="line;strokeColor=#bbbbbb;" value="" vertex="1">
          <mxGeometry height="1" width="694" x="822" y="706" as="geometry" />
        </mxCell>
        <mxCell id="n4322_38" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#333333;" value="Cita representativa" vertex="1">
          <mxGeometry height="16" width="200" x="822" y="714" as="geometry" />
        </mxCell>
        <mxCell id="n4322_39" parent="1" style="text;html=1;align=left;fontSize=10;fontStyle=2;fontColor=#555555;" value="“Me preguntan por la deuda y tengo que llamar a la oficina.”" vertex="1">
          <mxGeometry height="26" width="690" x="822" y="732" as="geometry" />
        </mxCell>
        <mxCell id="n4322_40" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#333333;" value="Pantallas que lo resuelven: D1, D3 (acceso restringido)" vertex="1">
          <mxGeometry height="20" width="690" x="822" y="766" as="geometry" />
        </mxCell>
        <mxCell id="n4322_41" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#555555;" value="Técnica aplicada: entrevista breve y mapa de empatía (qué piensa, siente, hace y le duele)." vertex="1">
          <mxGeometry height="20" width="690" x="822" y="792" as="geometry" />
        </mxCell>
        <mxCell id="n4322_42" parent="1" style="text;html=1;align=left;fontSize=11;fontStyle=2;fontColor=#555555;" value="Técnica 1 — Construcción de personas y mapa de empatía. Permite pasar de &#39;los residentes&#39; como masa indiferenciada a cuatro perfiles con necesidades y frustraciones distintas y verificables contra el caso de negocio." vertex="1">
          <mxGeometry height="30" width="1440" x="50" y="940" as="geometry" />
        </mxCell>
